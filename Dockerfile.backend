FROM python:3.11-slim

# Build argument to determine environment (development or production)
ARG BUILD_ENV=production

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY backend/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the backend application
COPY backend/ .

# Copy sample hand history for demo data
COPY hand_histories/ ./hand_histories/

# Create uploads directory
RUN mkdir -p uploads

# Expose the port
EXPOSE 5000

# Set environment variables based on build environment
ENV FLASK_APP=server.py
ENV PYTHONPATH=/app

# Default environment variables (can be overridden at runtime)
ENV FLASK_ENV=production
ENV FLASK_DEBUG=false
ENV PYTHONUNBUFFERED=1

# Start the application
# Use -u flag for unbuffered output (useful for development logging)
CMD ["python", "-u", "server.py"]
