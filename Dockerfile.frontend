FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm install

# Copy the frontend application
COPY frontend/ .

# Set environment variable to skip linting during build
ENV ESLINT_NO_DEV_ERRORS=true
ENV CI=false

# Build the application
RUN npm run build

# Expose the port
EXPOSE 3000

# Start the application
CMD ["npm", "start"]
